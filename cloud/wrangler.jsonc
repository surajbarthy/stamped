{
  // Slop Stamp: the public site, the wall, and its API on one Worker.
  // Live at slopstamp.xyz. DEPLOY.md covers setting this up from scratch.
  "name": "slop-stamp",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stamped",
      "database_id": "081e02e9-8017-421e-8309-f96079ce1036",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "stamped-media"
    }
  ],
  "ratelimits": [
    {
      "name": "POST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "REPORTS_TO_HIDE": "3",
    "MAX_PENDING": "300"
  },
  "routes": [
    { "pattern": "slopstamp.xyz", "custom_domain": true },
    { "pattern": "www.slopstamp.xyz", "custom_domain": true }
  ]
}
